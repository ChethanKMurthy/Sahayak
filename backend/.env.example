# ─── Sahayak backend configuration ───────────────────────────────────────────
# Everything works with ZERO keys: adapters fall back to realistic mocks.
# Set a provider to its real value to switch that adapter to the live service.

# Database. Defaults to local SQLite. For Postgres/RDS use e.g.:
#   postgresql+psycopg://user:pass@host:5432/sahayak
DATABASE_URL=sqlite:///./sahayak.db

# CORS origins for the web app
CORS_ORIGINS=http://localhost:3000

# ─── Reasoning LLM: Grok (xAI) ───────────────────────────────────────────────
# Leave blank to use the deterministic mock extractor/explainer.
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-fast
GROK_MODEL_LARGE=grok-4         # escalation tier for low-confidence cases

# ─── OCR: on-device ML Kit (client) + AWS Textract (server fallback) ─────────
# OCR_PROVIDER: mock | textract
OCR_PROVIDER=mock

# ─── Voice: Bhashini (primary) + AWS Transcribe/Polly (fallback) ─────────────
# VOICE_PROVIDER: mock | bhashini | aws
VOICE_PROVIDER=mock
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# ─── AWS (Textract / Transcribe / Polly / S3 / Cognito / SNS) ────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=sahayak-documents
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Session TTL (seconds) — ephemeral by default
SESSION_TTL_SECONDS=86400
