      {"key": "ifsc", "type": "ifsc", "required": true, "label": {"en": "Bank IFSC", "hi": "बैंक IFSC"}, "source_hints": ["bank_passbook.ifsc"], "validations": ["ifsc"]}
    ],
    "attachments": [
      {"doc": "aadhaar", "copies": 1, "note": {"en": "Photocopy of Aadhaar", "hi": "आधार की फोटोकॉपी"}},
      {"doc": "land_record", "copies": 1, "original": true, "note": {"en": "Land record (7/12 / khasra-khatauni)", "hi": "भूमि रिकॉर्ड (7/12 / खसरा-खतौनी)"}},
      {"doc": "bank_passbook", "copies": 1, "note": {"en": "Bank passbook first page", "hi": "बैंक पासबुक का पहला पन्ना"}}
    ],
    "submit_to": {"office": {"en": "Village Revenue Officer / CSC / PM-KISAN portal", "hi": "ग्राम राजस्व अधिकारी / CSC / पीएम-किसान पोर्टल"}, "online_wall": false, "fee": 0, "tout_price": 300}
  },
  {
    "id": "nfsa-ration-card",
