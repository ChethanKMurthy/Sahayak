    "jurisdiction": {"country": "IN", "state": "*"},
    "fields": [
      {"key": "applicant_name", "type": "name", "required": true, "label": {"en": "Head of household name", "hi": "परिवार के मुखिया का नाम"}, "source_hints": ["aadhaar.name"], "validations": ["nonEmpty"]},
