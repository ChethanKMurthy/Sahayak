[
  {
    "id": "pan-49a",
    "version": "2024.1",
    "scheme_id": "pan-49a",
    "title": {"en": "Form 49A — PAN Application", "hi": "फ़ॉर्म 49A — पैन आवेदन"},
    "jurisdiction": {"country": "IN", "state": "*"},
    "fields": [
      {"key": "applicant_name", "type": "name", "required": true, "label": {"en": "Full name", "hi": "पूरा नाम"}, "source_hints": ["aadhaar.name"], "validations": ["nonEmpty"]},
      {"key": "father_name", "type": "name", "required": true, "label": {"en": "Father's name", "hi": "पिता का नाम"}, "source_hints": ["aadhaar.father_name"]},
      {"key": "dob", "type": "date", "required": true, "label": {"en": "Date of birth", "hi": "जन्मतिथि"}, "source_hints": ["aadhaar.dob"], "validations": ["pastDate"]},
      {"key": "gender", "type": "enum", "required": true, "label": {"en": "Gender", "hi": "लिंग"}, "options": ["male", "female", "other"], "source_hints": ["aadhaar.gender"]},
      {"key": "address", "type": "address", "required": true, "label": {"en": "Address", "hi": "पता"}, "source_hints": ["aadhaar.address"], "validations": ["nonEmpty"]},
      {"key": "ao_code", "type": "text", "required": false, "label": {"en": "AO code (jurisdiction — auto-looked-up)", "hi": "AO कोड (क्षेत्राधिकार — स्वतः खोजा गया)"}, "validations": []}
    ],
    "attachments": [
      {"doc": "aadhaar", "copies": 1, "note": {"en": "Aadhaar as identity + address proof", "hi": "पहचान + पते के प्रमाण के रूप में आधार"}},
      {"doc": "passport_photo", "copies": 2, "note": {"en": "Two passport-size photos", "hi": "दो पासपोर्ट आकार की फोटो"}}
    ],
    "submit_to": {"office": {"en": "NSDL/UTIITSL PAN centre or online", "hi": "NSDL/UTIITSL पैन केंद्र या ऑनलाइन"}, "online_wall": false, "fee": 107, "tout_price": 400}
  },
  {
    "id": "pm-kisan",
    "version": "2024.1",
    "scheme_id": "pm-kisan",
    "title": {"en": "PM-KISAN Enrolment", "hi": "पीएम-किसान नामांकन"},
    "jurisdiction": {"country": "IN", "state": "*"},
    "fields": [
      {"key": "applicant_name", "type": "name", "required": true, "label": {"en": "Farmer's full name", "hi": "किसान का पूरा नाम"}, "source_hints": ["aadhaar.name"], "validations": ["nonEmpty"]},
      {"key": "dob", "type": "date", "required": true, "label": {"en": "Date of birth", "hi": "जन्मतिथि"}, "source_hints": ["aadhaar.dob"]},
      {"key": "gender", "type": "enum", "required": true, "label": {"en": "Gender", "hi": "लिंग"}, "options": ["male", "female", "other"], "source_hints": ["aadhaar.gender"]},
      {"key": "address", "type": "address", "required": true, "label": {"en": "Address", "hi": "पता"}, "source_hints": ["aadhaar.address"]},
      {"key": "owns_cultivable_land", "type": "boolean", "required": true, "label": {"en": "Owns cultivable land?", "hi": "खेती योग्य ज़मीन है?"}, "source_hints": ["land_record.owns_cultivable_land"]},
      {"key": "land_area", "type": "text", "required": false, "label": {"en": "Land area (from 7/12 / khasra)", "hi": "भूमि क्षेत्र (7/12 / खसरा से)"}, "source_hints": ["land_record.land_area"]},
      {"key": "is_income_tax_payer", "type": "boolean", "required": true, "label": {"en": "Income-tax payer?", "hi": "आयकर दाता?"}},
      {"key": "is_govt_employee", "type": "boolean", "required": true, "label": {"en": "Government employee?", "hi": "सरकारी कर्मचारी?"}},
